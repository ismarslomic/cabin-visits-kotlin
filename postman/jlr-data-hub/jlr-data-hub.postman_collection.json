        {
          "name": "Journeys (date range)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "DPoP {{accessToken}}",
                "type": "text"
              },
              {
                "key": "DPoP",
                "value": "{{dpopProof}}",
                "type": "text"
              },
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "description": "Journeys between journeysFrom and journeysTo (ISO date-time, inclusive).",
            "url": {
              "raw": "{{baseUrl}}/v1/vehicles/{{vin}}/journeys?page=0&size=20&from={{journeysFrom}}&to={{journeysTo}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "vehicles",
                "{{vin}}",
